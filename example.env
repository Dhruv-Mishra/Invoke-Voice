# Voice Work Supervisor optional source/automation overrides.
# Normal desktop users configure providers in Settings > Config and do not need .env.

PORT=4317
DEFAULT_PROVIDER=local
DEFAULT_VOICE_MODE=local

# Optional IT-approved Python package mirrors for local voice setup.
# LOCAL_PYPI_INDEX_URL=https://pypi.org/simple
# LOCAL_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Optional matching release dependency pack supplied or mirrored by IT.
# LOCAL_VOICE_PACK_FILE=C:\ApprovedDownloads\voice-dependencies-<release-hash>.tar.xz
# LOCAL_VOICE_PACK_URL=https://approved.example/voice-dependencies-<release-hash>.tar.xz

# --- Gemini (Cloud Default & Gemini Live) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_STT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- OpenAI (Optional Chat & Realtime) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local LLM (llama.cpp server / OpenAI-compatible loopback only) ---
LOCAL_LLM_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_MODEL=ling-local
LOCAL_LLM_PATH=..\LocalVoiceStack\LLMs\Ling-3.0-tiny-abliterated-APEX-I-Compact.gguf
# Automatic thread budget leaves CPU capacity for speech and the UI.
# LLAMA_THREADS=8
LLAMA_CONTEXT=4096
LLAMA_LOAD_MODE=mmap
LLAMA_PARALLEL=1
LLAMA_CACHE_REUSE=32
LLAMA_FLASH_ATTN=auto
LLAMA_GPU_LAYERS=auto
# Quantized KV is opt-in; benchmark the same model before enabling it.
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16

# --- Local Voice Pipeline (Moonshine Tiny streaming + Silero VAD + Kokoro TTS) ---
PYTHON_BIN=
LOCAL_STT_PROVIDER=moonshine
WHISPER_LANGUAGE=auto
WHISPER_END_SILENCE_MS=1400
# WHISPER_THREADS=8
# Whisper Small INT8 is optional; select whisper in Settings and run setup.
CRISPASR_STREAM_STEP_MS=500
CRISPASR_STREAM_LENGTH_MS=4000
CRISPASR_PARTIAL_DECODE_MS=4000
CRISPASR_PARTIAL_TAIL_SEC=4
END_SILENCE_MS=1400
CRISPASR_FINAL_MODE=redecode
# CRISPASR_THREADS=12
# AVX2 is opt-in and requires AVX2, FMA and F16C CPU support; run setup again.
# CRISPASR_CPU=avx2
KOKORO_THREADS=8
MOONSHINE_MODEL=..\LocalVoiceStack\STT_Models\moonshine-streaming-tiny-q4_k.gguf
KOKORO_REPO=hexgrad/Kokoro-82M
KOKORO_VOICE=af_heart
# Set to 0 to load the selected recognizer and Kokoro on first voice connection.
PREWARM_LOCAL_VOICE=1

# --- Task Backends (Agency is the fresh-install default; saved choices are preserved) ---
COPILOT_CLI=copilot.exe
AGENCY_CLI=agency.exe
# Opt in to read-only WorkIQ/Teams/calendar/people tasks; uses cloud processing and saved history.
AGENCY_WORK_DATA_ACCESS=disabled
COPILOT_MODEL=gpt-5.6-sol
COPILOT_CONTEXT=default
COPILOT_REASONING=medium

# --- Optional Path Overrides (Defaults to %LOCALAPPDATA%\VoiceSupervisor outside OneDrive) ---
# MODEL_DIR=
# RUNTIME_DIR=
# CRISPASR_BIN=
# MOONSHINE_MODEL=
# VAD_MODEL=
# SUPERVISOR_DATA_DIR=
