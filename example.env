# Voice Work Supervisor Environment Configuration
# Copy this file to .env and configure your keys privately.

PORT=4317
DEFAULT_PROVIDER=local
DEFAULT_VOICE_MODE=local

# --- Gemini (Cloud Default & Gemini Live) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- OpenAI (Optional Chat & Realtime) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Optional Chat) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Azure OpenAI (Optional Chat) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Custom OpenAI-compatible endpoint (Optional) ---
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Local LLM (llama.cpp server / OpenAI-compatible loopback only) ---
LOCAL_LLM_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_MODEL=ling-local
LOCAL_LLM_PATH=..\LocalVoiceStack\LLMs\Ling-3.0-tiny-abliterated-APEX-I-Compact.gguf
LLAMA_THREADS=12
LLAMA_CONTEXT=8192
LLAMA_LOAD_MODE=mmap
LLAMA_PARALLEL=2
LLAMA_CACHE_REUSE=32

# --- Local Voice Pipeline (CrispASR + Moonshine + Silero VAD + Kokoro TTS) ---
PYTHON_BIN=.venv\Scripts\python.exe
LOCAL_THREADS=4
CRISPASR_STREAM_STEP_MS=500
CRISPASR_STREAM_LENGTH_MS=8000
CRISPASR_PARTIAL_DECODE_MS=1000
CRISPASR_PARTIAL_TAIL_SEC=6
END_SILENCE_MS=500
CRISPASR_FINAL_MODE=prefix
CRISPASR_THREADS=12
KOKORO_THREADS=8
MOONSHINE_MODEL=..\LocalVoiceStack\STT_Models\moonshine-streaming-small-q4_k.gguf
KOKORO_REPO=hexgrad/Kokoro-82M
KOKORO_VOICE=af_heart
# Set to 0 to load CrispASR and Kokoro on first voice connection instead of app startup.
PREWARM_LOCAL_VOICE=1

# --- Coding Backends (GitHub Copilot CLI and optional Agency) ---
COPILOT_CLI=copilot.exe
AGENCY_CLI=agency.exe
COPILOT_MODEL=gpt-5.6-sol
COPILOT_CONTEXT=default
COPILOT_REASONING=medium

# --- Optional Path Overrides (Defaults to %LOCALAPPDATA%\VoiceSupervisor outside OneDrive) ---
# MODEL_DIR=
# RUNTIME_DIR=
# CRISPASR_BIN=
# MOONSHINE_MODEL=
# VAD_MODEL=
# SUPERVISOR_DATA_DIR=
