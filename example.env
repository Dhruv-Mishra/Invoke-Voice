# Voice Work Supervisor optional source/automation overrides.
# Normal desktop users configure providers in Settings > Config and do not need .env.

PORT=4317
DEFAULT_PROVIDER=local
DEFAULT_VOICE_MODE=local

# Optional IT-approved Python package mirrors for local voice setup.
# LOCAL_PYPI_INDEX_URL=https://pypi.org/simple
# LOCAL_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Optional matching release dependency pack supplied or mirrored by IT.
# LOCAL_VOICE_PACK_FILE=C:\ApprovedDownloads\voice-dependencies-<release-hash>.tar.xz
# LOCAL_VOICE_PACK_URL=https://approved.example/voice-dependencies-<release-hash>.tar.xz

# --- Gemini (Cloud Default & Gemini Live) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_STT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- OpenAI (Optional Chat & Realtime) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local LLM (llama.cpp server / OpenAI-compatible loopback only) ---
LOCAL_LLM_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_MODEL=ling-local
LOCAL_LLM_PATH=
# Raw-scored is the fresh-install default; experimental and NOT through accuracy/safety gates.
# Set off for the Regular planner; shadow observes choices without executing them.
LOCAL_ROUTER=scored
# LOCAL_ROUTER=shadow
# Permissive raw-scored policy, not a calibrated confidence guarantee.
# For diagnostic full abstention, set both thresholds to 1.
LOCAL_ROUTER_MIN_PROBABILITY=0
LOCAL_ROUTER_MIN_MARGIN=0
# Automatic thread budget uses the estimated physical core count (capped at 16).
# LLAMA_THREADS=8
# LLAMA_THREADS_BATCH=8
# LLAMA_BATCH_SIZE=256
# LLAMA_UBATCH_SIZE=256
LLAMA_CONTEXT=4096
LLAMA_LOAD_MODE=auto
LLAMA_PARALLEL=1
# Routing reasoning cap; 0 can reduce tool accuracy, -1 is unlimited. Summaries use 0.
LLAMA_REASONING_BUDGET=256
LLAMA_CACHE_REUSE=32
LLAMA_FLASH_ATTN=auto
LLAMA_GPU_LAYERS=auto
# cpu (default) or vulkan: pinned llama.cpp Vulkan build for partial GPU offload; rerun local setup.
LLAMA_BACKEND=cpu
# Quantized KV is opt-in; benchmark the same model before enabling it.
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16
# Prepare the local model with Whisper's provisional transcript (Regular routing only).
LOCAL_EARLY_PREFILL=on

# --- Opt-in Qwen3.6 35B-A3B MoE (about 24 GB RAM; run local setup after switching) ---
# LOCAL_LLM_PROFILE=qwen
# QWEN_MODEL_PATH=
# Multi-token prediction: downloads the 0.5 GB MTP layer and builds a 24 GB accelerated copy.
# QWEN_MTP=on
# QWEN_DRAFT_TOKENS=2
# Defaults: physical cores capped at 12 (generation) and 16 (prompt/MTP verification).
# QWEN_THREADS=12
# QWEN_THREADS_BATCH=16
# QWEN_CONTEXT=8192

# --- Local Voice Pipeline (Whisper Small INT8 + Kokoro TTS; Moonshine opt-in) ---
PYTHON_BIN=
LOCAL_STT_PROVIDER=whisper
WHISPER_LANGUAGE=en
WHISPER_END_SILENCE_MS=1400
WHISPER_PREDECODE_MS=480
# WHISPER_THREADS=8
# Moonshine Tiny is optional; select moonshine in Settings and run setup.
CRISPASR_STREAM_STEP_MS=500
CRISPASR_STREAM_LENGTH_MS=4000
CRISPASR_PARTIAL_DECODE_MS=4000
CRISPASR_PARTIAL_TAIL_SEC=4
END_SILENCE_MS=1400
CRISPASR_FINAL_MODE=redecode
# CRISPASR_THREADS=12
# AVX2 is opt-in and requires AVX2, FMA and F16C CPU support; run setup again.
# CRISPASR_CPU=avx2
KOKORO_THREADS=8
MOONSHINE_MODEL=..\LocalVoiceStack\STT_Models\moonshine-streaming-tiny-q4_k.gguf
KOKORO_REPO=hexgrad/Kokoro-82M
KOKORO_VOICE=af_heart
# Set to 0 to load the selected recognizer and Kokoro on first voice connection.
PREWARM_LOCAL_VOICE=1

# --- Task Backends (Agency is the fresh-install default; saved choices are preserved) ---
COPILOT_CLI=copilot.exe
AGENCY_CLI=agency.exe
# Opt in to read-only M365 tasks through WorkIQ; uses cloud processing and saved history.
AGENCY_WORK_DATA_ACCESS=disabled
# expanded additionally enables dedicated Teams/calendar/people read tools.
AGENCY_M365_TOOLS=workiq
# Requires private work access too; direct chat and voice reads avoid an Agency task.
VOICE_DIRECT_MCP_ACCESS=disabled
COPILOT_MODEL=gpt-5.6-sol
COPILOT_CONTEXT=default
COPILOT_REASONING=medium

# --- Optional Path Overrides (Defaults to %LOCALAPPDATA%\VoiceSupervisor outside OneDrive) ---
# MODEL_DIR=
# RUNTIME_DIR=
# CRISPASR_BIN=
# MOONSHINE_MODEL=
# VAD_MODEL=
# SUPERVISOR_DATA_DIR=
