{
  "name": "invoke-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop.cjs",
  "description": "Invoke - From Voice to Agency. Local-first voice orchestration for coding, research and work.",
  "homepage": "https://github.com/Dhruv-Mishra/Invoke-Voice",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dhruv-Mishra/Invoke-Voice.git"
  },
  "author": {
    "name": "Dhruv Mishra",
    "email": "dhruvmishra.id@gmail.com"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "node --env-file-if-exists=.env scripts/start.mjs --debug",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "local": "node --env-file-if-exists=.env scripts/start.mjs --local",
    "local:check": "node --env-file-if-exists=.env scripts/start.mjs --local --check",
    "copilot:check": "node --env-file-if-exists=.env scripts/check-copilot.mjs",
    "agency:check": "node --env-file-if-exists=.env scripts/check-copilot.mjs --agency",
    "agency:read:check": "node scripts/check-agency-read.mjs",
    "test": "node --test test/*.test.mjs",
    "desktop": "npm run build && node scripts/desktop-icon.mjs && electron desktop.cjs",
    "kokoro-pack": "node scripts/build-kokoro-pack.mjs",
    "dist:win": "node scripts/dist-win.mjs",
    "dist:win:bundled": "node scripts/dist-win.mjs bundled",
    "dist:win:online": "node scripts/dist-win.mjs online",
    "release:beta": "node scripts/publish-beta.mjs",
    "release:beta:local": "node scripts/publish-beta-local.mjs",
    "release:stable:local": "node scripts/publish-beta-local.mjs stable",
    "models": "node --env-file-if-exists=.env scripts/models.mjs",
    "search": "zg query",
    "search:index": "zg index --embedding local/potion-code-16m-v2",
    "search:status": "zg status",
    "search:server": "zg server on",
    "search:setup": "zg index --embedding local/potion-code-16m-v2 && zg server on"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dompurify": "^3.4.15",
    "lucide": "^1.42.0",
    "marked": "^18.0.12",
    "minisearch": "^7.2.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.7.3",
    "vue": "^3.5.21",
    "ws": "^8.21.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@zvec/zvec-grep": "^0.2.2",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "sharp": "0.35.4",
    "vite": "^7.1.5"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "build": {
    "appId": "com.dhruvmishra.invoke",
    "productName": "Invoke",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "compression": "maximum",
    "files": [
      "desktop.cjs",
      "desktop-preload.cjs",
      "desktop-update.cjs",
      "package.json",
      "src/**/*.mjs",
      "dist/**/*",
      "scripts/models.mjs",
      "scripts/start.mjs",
      "scripts/desktop-launch.cjs",
      "scripts/kokoro_worker.py",
      "scripts/whisper_worker.py",
      "scripts/voice_pack.py",
      "build/invoke.png",
      "requirements-local.txt",
      "requirements-whisper.txt",
      "!**/.env*",
      "!**/*.{gguf,pth,pt}",
      "!**/{test,tests,artifacts,state,.git,.venv,__pycache__}/**",
      "artifacts/voice-pack/descriptor.json",
      "artifacts/voice-pack/*.tar.xz",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
    ],
    "asarUnpack": [
      "src/**",
      "scripts/**",
      "dist/**",
      "artifacts/voice-pack/**",
      "requirements-local.txt",
      "requirements-whisper.txt",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/invoke.ico",
      "signAndEditExecutable": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
