{
  "name": "voice-work-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && node --env-file-if-exists=.env src/server.mjs",
    "local": "npm run build && node --env-file-if-exists=.env scripts/start-local.mjs",
    "local:check": "node --env-file-if-exists=.env scripts/start-local.mjs --check",
    "copilot:check": "node --env-file-if-exists=.env scripts/check-copilot.mjs",
    "agency:check": "node --env-file-if-exists=.env scripts/check-copilot.mjs --agency",
    "test": "node --test test/*.test.mjs",
    "desktop": "npm run build && electron desktop.cjs",
    "models": "node --env-file-if-exists=.env scripts/models.mjs",
    "search": "zg query",
    "search:index": "zg index --embedding local/potion-code-16m-v2",
    "search:status": "zg status",
    "search:server": "zg server on",
    "search:setup": "zg index --embedding local/potion-code-16m-v2 && zg server on"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "dompurify": "^3.4.15",
    "lucide": "^1.42.0",
    "marked": "^18.0.12",
    "vue": "^3.5.21",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@zvec/zvec-grep": "^0.2.2",
    "electron": "^45.0.0-alpha.5",
    "vite": "^7.1.5"
  }
}
